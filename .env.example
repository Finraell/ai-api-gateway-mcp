# Copy this file to .env before running Docker Compose.
# Do not commit the real .env file.

# Backend API key. This is injected into the backend and nginx reverse proxy.
GATEWAY_API_KEY=replace-with-a-long-random-local-secret

# Postgres credentials for local Docker.
POSTGRES_DB=ai_gateway
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

# Local demo default: false, so Kafka is not required.
# To test Kafka publishing: set true and run `docker compose --profile events up --build`.
RISK_EVENTS_ENABLED=false
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Spring AI MCP server. This exposes MCP tools; it does not require OpenAI/Claude keys.
SPRING_AI_MCP_ENABLED=true

# Auth hardening options.
# Docker demo keeps API key enabled because nginx injects it server-side.
GATEWAY_API_KEY_ENABLED=true
# Set true to accept Bearer JWTs signed with HMAC SHA-256. In production, replace this demo verifier with OAuth2/OIDC issuer validation.
GATEWAY_JWT_ENABLED=false
GATEWAY_JWT_HMAC_SECRET=replace-with-at-least-32-random-characters

# In-memory local/demo rate limit. Production systems usually use Redis, gateway-level, or service-mesh rate limiting.
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_PER_MINUTE=120

# Optional Grafana dashboard profile. Change this before running `docker compose --profile dashboards up --build`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
